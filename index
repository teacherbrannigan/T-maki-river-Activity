<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
  <title>NZ CIVIL DEFENCE // SUB-SURFACE BUNKER SYSTEM</title>
  <style>
    :root {
      --cd-yellow: #ffcc00;
      --cd-orange: #ff6600;
      --cd-blue: #003366;
      --cd-dark: #12161a;
      --cd-panel: #1e242b;
      --cd-border: #333d47;
      --cd-green: #00ff66;
      --cd-text: #e1e6eb;
      --cd-font: "Courier New", Courier, monospace, sans-serif;
    }

    * {
      box-sizing: border-box;
      user-select: none;
      -webkit-user-select: none;
    }

    body {
      margin: 0;
      padding: 0;
      background-color: var(--cd-dark);
      color: var(--cd-text);
      font-family: var(--cd-font);
      height: 100vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    /* HEADER BAR */
    header {
      background-color: var(--cd-blue);
      border-bottom: 4px solid var(--cd-yellow);
      padding: 12px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .badge {
      background-color: var(--cd-yellow);
      color: #000;
      font-weight: bold;
      padding: 6px 12px;
      border-radius: 3px;
      letter-spacing: 1px;
      font-size: 0.9rem;
    }

    .title {
      font-size: 1.2rem;
      font-weight: bold;
      letter-spacing: 2px;
      color: #fff;
    }

    .status-bar {
      display: flex;
      gap: 20px;
      font-size: 0.85rem;
    }

    .status-item {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .indicator {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background-color: var(--cd-green);
      box-shadow: 0 0 8px var(--cd-green);
    }

    .indicator.alert {
      background-color: var(--cd-orange);
      box-shadow: 0 0 8px var(--cd-orange);
      animation: blink 1s infinite;
    }

    @keyframes blink {
      50% { opacity: 0.3; }
    }

    /* MAIN CONTAINER */
    main {
      flex: 1;
      padding: 20px;
      display: flex;
      justify-content: center;
      align-items: center;
      position: relative;
    }

    .bunker-card {
      background-color: var(--cd-panel);
      border: 2px solid var(--cd-border);
      border-radius: 8px;
      width: 100%;
      max-width: 900px;
      height: 100%;
      max-height: 580px;
      display: flex;
      flex-direction: column;
      box-shadow: 0 8px 24px rgba(0,0,0,0.6);
      position: relative;
      overflow: hidden;
    }

    .card-header {
      background-color: #171c22;
      border-bottom: 1px solid var(--cd-border);
      padding: 10px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.85rem;
      color: #8899a6;
    }

    .card-body {
      flex: 1;
      padding: 30px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    /* ROOM SECTIONS */
    .stage {
      display: none;
      height: 100%;
      flex-direction: column;
      justify-content: space-between;
    }

    .stage.active {
      display: flex;
    }

    h1, h2 {
      color: var(--cd-yellow);
      margin-top: 0;
      text-transform: uppercase;
      letter-spacing: 1.5px;
    }

    p {
      line-height: 1.6;
      font-size: 1.05rem;
      color: var(--cd-text);
    }

    /* NAVIGATION / BUTTONS */
    .action-zone {
      margin-top: 20px;
      padding-top: 20px;
      border-top: 1px dashed var(--cd-border);
      display: flex;
      justify-content: flex-end;
    }

    .btn {
      background-color: var(--cd-yellow);
      color: #000;
      border: none;
      padding: 14px 28px;
      font-size: 1rem;
      font-weight: bold;
      font-family: inherit;
      cursor: pointer;
      text-transform: uppercase;
      letter-spacing: 1px;
      border-radius: 4px;
      transition: all 0.2s ease;
      box-shadow: 0 4px 0 #cca300;
    }

    .btn:active {
      transform: translateY(4px);
      box-shadow: 0 0 0 #cca300;
    }

    .btn-danger {
      background-color: var(--cd-orange);
      box-shadow: 0 4px 0 #cc5200;
    }

    .btn-danger:active {
      box-shadow: 0 0 0 #cc5200;
    }

    /* FOOTER TRACKER */
    footer {
      background-color: #0b0e11;
      border-top: 1px solid var(--cd-border);
      padding: 10px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.8rem;
    }

    .progress-tracker {
      display: flex;
      gap: 10px;
    }

    .step-dot {
      width: 25px;
      height: 8px;
      background-color: var(--cd-border);
      border-radius: 2px;
      transition: background-color 0.3s;
    }

    .step-dot.completed {
      background-color: var(--cd-green);
    }

    .step-dot.current {
      background-color: var(--cd-yellow);
    }
  </style>
</head>
<body>

  <!-- HEADER NAVIGATION BAR -->
  <header>
    <div class="brand">
      <div class="badge">CIVIL DEFENCE</div>
      <div class="title">TĀMAKI EMERGENCY BUNKER #07</div>
    </div>
    <div class="status-bar">
      <div class="status-item">
        <div class="indicator alert" id="system-status"></div>
        <span id="status-text">LOCKDOWN ACTIVE</span>
      </div>
      <div class="status-item">
        <span>SECTOR: SOUTH AUCKLAND</span>
      </div>
    </div>
  </header>

  <!-- MAIN ESCAPE ROOM STAGE CONTAINER -->
  <main>
    <div class="bunker-card">
      <div class="card-header">
        <span id="stage-id">SYS_ID: INTRO_PAGE</span>
        <span>SECURITY LEVEL: RESTRICTED</span>
      </div>

      <div class="card-body">

        <!-- =======================================================
             MAIN INTRODUCTION PAGE
        ======================================================== -->
        <section id="stage-0" class="stage active">
          <div>
            <h1>Emergency Override Protocol</h1>
            <p><strong>ALERT:</strong> Unscheduled seismic event registered along the Tāmaki River corridor. Blast doors have sealed automatically.</p>
            <p>You and your team are currently locked inside Sub-surface Emergency Bunker #07. All automated life support systems are on lockdown.</p>
            <p>To initiate manual override and open the emergency exit hatch, you must navigate through 5 security override chambers.</p>
          </div>
          
          <!-- BUTTON PLACEHOLDER FOR NEXT STAGE -->
          <div class="action-zone">
            <button class="btn btn-danger" onclick="nextStage(1)">INITIATE SYSTEM OVERRIDE →</button>
          </div>
        </section>

        <!-- =======================================================
             ROOM 1: STAGE 1
        ======================================================== -->
        <section id="stage-1" class="stage">
          <div>
            <h2>Stage 1: Power & Grid Distribution</h2>
            <p>[PLACEHOLDER: Add Stage 1 puzzle/code here]</p>
          </div>

          <!-- REPLACE THIS BLOCK WITH ROOM 1 PUZZLE LOGIC & CUSTOM BUTTON -->
          <div class="action-zone">
            <button class="btn" onclick="nextStage(2)">OVERRIDE GRID (STAGE 2) →</button>
          </div>
          <!-- END ROOM 1 ACTION BLOCK -->
        </section>

        <!-- =======================================================
             ROOM 2: STAGE 2
        ======================================================== -->
        <section id="stage-2" class="stage">
          <div>
            <h2>Stage 2: Water Filtration & Estuarine Pump</h2>
            <p>[PLACEHOLDER: Add Stage 2 puzzle/code here]</p>
          </div>

          <!-- REPLACE THIS BLOCK WITH ROOM 2 PUZZLE LOGIC & CUSTOM BUTTON -->
          <div class="action-zone">
            <button class="btn" onclick="nextStage(3)">CLEAR PUMPS (STAGE 3) →</button>
          </div>
          <!-- END ROOM 2 ACTION BLOCK -->
        </section>

        <!-- =======================================================
             ROOM 3: STAGE 3
        ======================================================== -->
        <section id="stage-3" class="stage">
          <div>
            <h2>Stage 3: Communications Relay</h2>
            <p>[PLACEHOLDER: Add Stage 3 puzzle/code here]</p>
          </div>

          <!-- REPLACE THIS BLOCK WITH ROOM 3 PUZZLE LOGIC & CUSTOM BUTTON -->
          <div class="action-zone">
            <button class="btn" onclick="nextStage(4)">TRANSMIT SIGNAL (STAGE 4) →</button>
          </div>
          <!-- END ROOM 3 ACTION BLOCK -->
        </section>

        <!-- =======================================================
             ROOM 4: STAGE 4
        ======================================================== -->
        <section id="stage-4" class="stage">
          <div>
            <h2>Stage 4: Structural Integrity Monitor</h2>
            <p>[PLACEHOLDER: Add Stage 4 puzzle/code here]</p>
          </div>

          <!-- REPLACE THIS BLOCK WITH ROOM 4 PUZZLE LOGIC & CUSTOM BUTTON -->
          <div class="action-zone">
            <button class="btn" onclick="nextStage(5)">STABILIZE SECTOR (STAGE 5) →</button>
          </div>
          <!-- END ROOM 4 ACTION BLOCK -->
        </section>

        <!-- =======================================================
             ROOM 5: STAGE 5
        ======================================================== -->
        <section id="stage-5" class="stage">
          <div>
            <h2>Stage 5: Air Lock Unseal Sequence</h2>
            <p>[PLACEHOLDER: Add Stage 5 puzzle/code here]</p>
          </div>

          <!-- REPLACE THIS BLOCK WITH ROOM 5 PUZZLE LOGIC & CUSTOM BUTTON -->
          <div class="action-zone">
            <button class="btn btn-danger" onclick="nextStage(6)">UNSEAL BUNKER HATCH →</button>
          </div>
          <!-- END ROOM 5 ACTION BLOCK -->
        </section>

        <!-- =======================================================
             CONCLUSION PAGE
        ======================================================== -->
        <section id="stage-6" class="stage">
          <div>
            <h1 style="color: var(--cd-green);">Bunker Unsealed!</h1>
            <p><strong>SYSTEM OVERRIDE COMPLETE.</strong></p>
            <p>The blast doors have been retracted and environmental air locks are fully operational. Surface evacuation route is now clear.</p>
            <p>Great work, Civil Defence Response Team!</p>
          </div>

          <div class="action-zone">
            <button class="btn" onclick="nextStage(0)">↺ REBOOT SYSTEM</button>
          </div>
        </section>

      </div>
    </div>
  </main>

  <!-- FOOTER TRACKER -->
  <footer>
    <div>OPERATIONAL PROGRESS</div>
    <div class="progress-tracker">
      <div id="dot-1" class="step-dot"></div>
      <div id="dot-2" class="step-dot"></div>
      <div id="dot-3" class="step-dot"></div>
      <div id="dot-4" class="step-dot"></div>
      <div id="dot-5" class="step-dot"></div>
    </div>
  </footer>

  <!-- ENGINE NAVIGATION SCRIPT -->
  <script>
    let currentStage = 0;

    function nextStage(stageNumber) {
      // Hide current room
      document.getElementById(`stage-${currentStage}`).classList.remove('active');
      
      // Update stage variable
      currentStage = stageNumber;
      
      // Show next room
      const activeStage = document.getElementById(`stage-${currentStage}`);
      activeStage.classList.add('active');

      // Update UI Header
      const stageLabel = document.getElementById('stage-id');
      if(currentStage === 0) stageLabel.innerText = 'SYS_ID: INTRO_PAGE';
      else if(currentStage === 6) stageLabel.innerText = 'SYS_ID: ESCAPE_COMPLETE';
      else stageLabel.innerText = `SYS_ID: OVERRIDE_ROOM_0${currentStage}`;

      // Update UI Tracker Dots
      for (let i = 1; i <= 5; i++) {
        const dot = document.getElementById(`dot-${i}`);
        if (i < currentStage) {
          dot.className = 'step-dot completed';
        } else if (i === currentStage) {
          dot.className = 'step-dot current';
        } else {
          dot.className = 'step-dot';
        }
      }

      // Update system indicator on completion
      if(currentStage === 6) {
        document.getElementById('system-status').className = 'indicator';
        document.getElementById('status-text').innerText = 'SYSTEM SECURE';
      }
    }
  </script>
</body>
</html>
